# Copy this file to ".env" and fill in real values.
# .env is never committed to GitHub.

DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Leave blank to use SQLite while developing.
# Fill in for PostgreSQL on the server.
DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=
DB_PORT=5432

# WhatsApp Business API (added later, at the purchase order stage)
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
